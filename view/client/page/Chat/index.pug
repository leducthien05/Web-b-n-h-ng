extend ../../layout/default.pug

block main
    .container.my-3
        .row
            .col-12
                .chat
                    .inner-body
                        each chat in chats
                            div(class = (chat.user_id == user._id ? "inner-outgoing" : "inner-incoming"))
                                if(chat.user_id != user._id)
                                    .inner-name #{chat.name}   
                                .inner-content #{chat.content}
                    .inner-foot
                        form(
                            class = "inner-form"
                            action = ""
                        )
                            input(
                                name="content"
                                type="text" 
                                placeholder="Nhập nội dung..."
                                )
                            button(
                                type="submit"
                                class="fa-solid fa-paper-plane"
                                )

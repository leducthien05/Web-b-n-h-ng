extend ../../layout/default.pug

block main
    .container.my-3
        .row
            .col-12
                .chat(my-id=user._id)
                    .inner-body
                        each chat in chats
                            div(class = (chat.user_id == user._id ? "inner-outgoing" : "inner-incoming"))
                                if(chat.user_id != user._id)
                                    .inner-name #{chat.name}   
                                .inner-content #{chat.content}
                        .inner-typing
                            .typing-bubble
                                span
                                span
                                span
                    .inner-foot
                        form(
                            class = "inner-form"
                            action = ""
                        )
                            input(
                                name="content"
                                type="text" 
                                placeholder="Nhập nội dung..."
                                )
                            span(class="btn btn-light mx-2" button-icon) 
                                i(class="fa-regular fa-face-smile")
                            button(
                                type="submit"
                                class="fa-solid fa-paper-plane"
                                )
    div(class="tooltip" role="tooltip")
        emoji-picker


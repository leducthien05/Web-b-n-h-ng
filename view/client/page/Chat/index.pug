extend ../../layout/default.pug

block main
    .container.my-3
        .row
            .col-12
                .chat(my-id=user._id)
                    .inner-body
                        each chat in chats
                            div(class = (chat.user_id == user._id ? "inner-outgoing" : "inner-incoming"))
                                if(chat.user_id != user._id)
                                    .inner-name #{chat.name}   
                                if(chat.content)
                                    .inner-content #{chat.content}
                                if(chat.image.length > 0)
                                    .inner-images
                                        each item in chat.image
                                            img(src=item)
                        .inner-list-typing
                    div#preview-container
                    input(
                        class="filepond"
                        type="file",
                        name="images",
                        multiple,
                        accept="image/*"
                        id="upload-filepond"
                    )
                    .inner-foot
                        form(
                            class = "inner-form"
                            action = ""
                        )
                            input(
                                name="content"
                                type="text" 
                                placeholder="Nhập nội dung..."
                                )
                            span(class="btn btn-light mx-2" button-icon) 
                                i(class="fa-regular fa-face-smile")
                            //- upload ảnh
                            lable(
                                class="btn btn-light mx-2"
                                for="upload-filepond"
                                lable-upload
                            )   
                                i(class="fa-solid fa-image")
                            button(
                                type="submit"
                                class="fa-solid fa-paper-plane"
                                )
    div(class="tooltip" role="tooltip")
        emoji-picker


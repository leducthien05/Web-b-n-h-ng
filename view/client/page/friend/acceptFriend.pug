extends ../../layout/default
include ../../mixin/list-friend.pug

block main 
    .container.mt-4
        include ../../partial/friend_menu.pug
        div(class="col-lg-8 mx-auto")
            h3(class="mb-4 text-center") Lời mời kết bạn
        div(
            class="friend-list"
            data-accept-friend = user.id
            )
            each friend in friends
                div(class="card friend-card mb-3")
                    div(class="card-body d-flex align-items-center justify-content-between")
                        div(class="d-flex align-items-center")
                            img(
                                class="friend-avatar"
                                src="https://www.vietnamworks.com/hrinsider/wp-content/uploads/2023/12/anh-den-ngau.jpeg"
                            )
                            div(class="ms-3")
                                h6(class="mb-0") #{friend.username}
                            //-     small.text-muted= friend.mutual + " bạn chung"
                        div(class="d-flex gap-2 friend-actions add")
                            button(
                                class="btn btn-secondary btn-sm btn-deleted"
                            ) Đã xóa

                            button(
                                class="btn btn-primary btn-sm btn-accept"
                                btn-accept-friend=friend.id
                            ) Chấp nhận
                            button(
                                class="btn btn-secondary btn-sm btn-refuse"
                                btn-refuse-friend=friend.id
                            ) Xóa
                            div(
                                class="btn btn-info btn-sm btn-accepted"
                            ) Đã xác nhận
block script
    script(src="/client/JS/friend.js") 
extends ../../layout/default
include ../../mixin/list-friend.pug

block main 
    .container.mt-4
        include ../../partial/friend_menu.pug
        div(class="col-lg-8 mx-auto")
            h3(class="mb-4 text-center") Lời mời đã gửi
        div(class="friend-list")
            each friend in friends
                div(class="card friend-card mb-3")
                    div(class="card-body d-flex align-items-center justify-content-between")
                        div(class="d-flex align-items-center")
                            img(
                                class="friend-avatar"
                                src="https://www.vietnamworks.com/hrinsider/wp-content/uploads/2023/12/anh-den-ngau.jpeg"
                            )
                            div(class="ms-3")
                                h6(class="mb-0") #{friend.username}
                            //-     small.text-muted= friend.mutual + " bạn chung"
                        div(class="d-flex gap-2 friend-actions add")
                            button(
                                class="btn btn-primary btn-sm btn-add"
                                btn-add-friend=friend._id
                            ) Kết bạn

                            button(
                                class="btn btn-danger btn-sm btn-cancel"
                                btn-cancel-friend=friend._id
                            ) Hủy yêu cầu
                            //- button(
                            //-     class="btn btn-primary btn-sm btn-accept"
                            //-     btn-accept-friend=friend._id
                            //- ) Chấp nhận
block script
    script(src="/client/JS/friend.js") 
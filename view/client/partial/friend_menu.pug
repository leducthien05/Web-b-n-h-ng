div(class="friend-menu d-flex gap-2 mb-3")
    a(
        href="/friend"
        class="btn btn-primary"
    ) Danh sách bạn bè

    a(
        href="/friend/accept-friend"
        class="btn btn-primary"
    ) 
        | Lời mời kết bạn
        span(
            class="badge badge-light"
            badge-users-accept=user.id
        ) #{user.acceptFriends.length}

    a(
        href="/friend/request-friend"
        class="btn btn-primary"
    ) Lời mời đã gửi

    a(
        href="/friend/not-Friend"
        class="btn btn-primary"
    ) Danh sách người dùng